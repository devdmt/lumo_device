# ==============================================================================
# LumoDevice API Environment Variables
# ==============================================================================
# Copy this file to .env and fill in the actual values
# DO NOT commit .env to version control!

# ------------------------------------------------------------------------------
# Payload Decryption Configuration
# ------------------------------------------------------------------------------
# Used for decrypting encrypted API payloads from Safaricom and other partners

# Enable or disable payload decryption (true/false)
PayloadDecryptionOptions__Enabled=true

# Base64-encoded AES encryption key (required if Enabled=true)
# Get this key from Safaricom or your partner integration documentation
PayloadDecryptionOptions__EncryptionKey=

# Comma-separated list of routes that require payload decryption
# Example: /api/saf/v1/PhoneInsurance/customeronboarding,/api/mpesa/callback
PayloadDecryptionOptions__EncryptedRoutes=/api/saf/v1/PhoneInsurance/customeronboarding

# ------------------------------------------------------------------------------
# Notes:
# ------------------------------------------------------------------------------
# 1. The EncryptionKey should be a Base64-encoded string
# 2. Routes are matched using StartsWith, so /api/saf will match all Safaricom routes
# 3. To add multiple routes, separate them with commas (no spaces)
# 4. Use [SkipPayloadDecryption] attribute on specific endpoints to opt-out